# SECP - Sistema de Controle e Processos (PostgreSQL + pgvector & Redis)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=secp_user
POSTGRES_PASSWORD=secp_pass
POSTGRES_DB=secp_db
POSTGRES_ASYNC_DSN=postgresql+asyncpg://secp_user:secp_pass@127.0.0.1:5432/secp_db
POSTGRES_SYNC_DSN=postgresql+psycopg://secp_user:secp_pass@127.0.0.1:5432/secp_db
POSTGRES_PROD_REAL_ASYNC_DSN=postgresql+asyncpg://secp_user:secp_pass@127.0.0.1:5432/secp_prod_real
POSTGRES_PROD_REAL_SYNC_DSN=postgresql+psycopg://secp_user:secp_pass@127.0.0.1:5432/secp_prod_real

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_RBAC_TTL_SECONDS=300
REDIS_SRAG_TTL_SECONDS=600
